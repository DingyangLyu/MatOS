# Copy outside the checkout, then pass --env-file to scripts/matos-web.sh.
DEEPSEEK_API_KEY=
MATOS_DSH_MODEL=deepseek-flash
# State and ports are selected with --state-dir, --port and --daemon-port.
# The launcher keeps native and web state in the selected directory.

