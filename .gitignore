.matos/assets/
.matos/index/

# MuJoCo crash/warning logs dropped wherever the engine runs
MUJOCO_LOG.TXT

# Zip-extraction artifacts and local reference archives
__MACOSX/
/matos-tech/
/matos-tech.zip

# One-off QE budget scratch dirs
/.tmp-qe-budget-*/

# Self-evolution evidence snapshots carry embedded .matos runtime/source-cache
