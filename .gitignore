/artifacts/matos-self-evolution-*/

# Local editor settings
.vscode/

# labworld build output and test scratch
labworld/dist/
labworld/tests/draft-out/
labworld/.tmp-test/

# Materialized MuJoCo scenes generated per lab-env run
.matos/lab-env/

# Ops watchdog reports (timestamped runtime state)
.matos/ops/

# Locally rendered sim videos/demo media (commit curated copies under artifacts/ instead)
.matos-artifacts/

# Simulated SDL iteration records emitted by sdl-glue runs
matos-assets/packs/matos-virtual-lab/tools/sdl-glue/sdl-records/

# Deployment env template stays tracked; real deploy env values never enter git
!.env.deploy.example

# Local operator credential notes must never be committed
matos-beijing-admin-login.txt
*-admin-login.txt

# Mobile signing / distribution artifacts (closed-source hardening).
# Release keystore + signing.env live outside the repo in
# matos-tools/android-signing/ and must never be committed.
*.keystore
signing.env
*.apk
*.aab
google-services.json
GoogleService-Info.plist

# Private DSH upgrade runtimes, profiles, credentials and validation outputs.
.matos/dsh-*

# Prepared offline DSH distribution and private deployment acceptance state.
/vendor/deepseek-harness/runtime/
.matos/deployment-fix-*/
.matos/deployment-review-*/

# Public source setup intermediates and template.
/vendor/deepseek-harness/.dsh-prepare-*/

# Validated, immutable public runtime revisions and atomic selection.
/vendor/deepseek-harness/runtime-releases/
/vendor/deepseek-harness/runtime-active.json
/vendor/deepseek-harness/.runtime-update.lock
/vendor/deepseek-harness/.runtime-active-*.json

# Local public installation receipts and dependency caches.
/.matos/build-cache/
/.matos/public-installation.json
/.matos/offline-dependencies.json

# Per-installation state is never source.
/.matos/
# Local deployment settings and logs (may hold a model key).
matos-deploy.conf
matos-deploy.conf.pending
.matos/deploy/
