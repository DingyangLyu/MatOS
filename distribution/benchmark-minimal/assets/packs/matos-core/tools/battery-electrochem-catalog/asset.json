{
  "schemaVersion": 1,
  "id": "battery-electrochem-catalog",
  "type": "tool",
  "name": "Battery Electrochemistry Catalog",
  "version": "1.0.0",
  "description": "Discover and probe the mounted battery/electrochemistry macro-scale modelling toolchain: PyBaMM, PyBOP, BPX, liionpack, and OpenPNM.",
  "entry": "./tool.py",
  "tags": [
    "battery",
    "electrochemistry",
    "pybamm",
    "pybop",
    "bpx",
    "liionpack",
    "openpnm",
    "continuum"
  ],
  "permissions": {
    "shell": "disabled",
    "network": "disabled",
    "workspace": "read-only",
    "secrets": []
  },
  "metadata": {
    "kind": "external-tool",
    "sourceFormat": "cmatos-native-tool",
    "binding": "mcp__matos_asset__battery_electrochem_catalog",
    "promptPath": "prompt.md",
    "inputSchemaPath": "input.schema.json",
    "isReadOnly": true,
    "isDestructive": false,
    "family": "battery-electrochemistry",
    "executor": {
      "type": "matos-python",
      "runtime": "python3",
      "entry": "./tool.py",
      "timeoutMs": 30000,
      "mcpName": "battery_electrochem_catalog"
    },
    "marketplace": {
      "visibility": "public",
      "category": "tool"
    }
  }
}
