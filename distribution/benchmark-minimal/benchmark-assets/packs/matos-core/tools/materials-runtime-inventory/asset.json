{
  "schemaVersion": 1,
  "id": "materials-runtime-inventory",
  "type": "tool",
  "name": "Materials Runtime Inventory",
  "version": "1.0.0",
  "description": "Summarize the currently mounted local materials runtime assets: toolchains, Conda environments, MLIP models, and QE pseudopotentials.",
  "entry": "./tool.py",
  "tags": [
    "materials",
    "runtime",
    "inventory",
    "catalog",
    "preflight"
  ],
  "permissions": {
    "shell": "read-only",
    "network": "disabled",
    "workspace": "read-only",
    "secrets": [
      "MATOS_EXTERNAL_TOOLCHAIN_ROOT",
      "MATOS_CONTAINER_TOOLCHAIN_ROOT",
      "MATOS_COMPUTE_TOOLCHAIN_CONTAINER_ROOT",
      "MATOS_QE_PSEUDO_ROOT"
    ]
  },
  "metadata": {
    "kind": "external-tool",
    "sourceFormat": "cmatos-native-tool",
    "binding": "mcp__matos_asset__materials_runtime_inventory",
    "promptPath": "prompt.md",
    "inputSchemaPath": "input.schema.json",
    "isReadOnly": true,
    "isDestructive": false,
    "family": "materials-runtime",
    "executor": {
      "type": "matos-python",
      "runtime": "python3",
      "entry": "./tool.py",
      "timeoutMs": 45000,
      "mcpName": "materials_runtime_inventory"
    },
    "marketplace": {
      "visibility": "public",
      "category": "tool"
    }
  }
}
