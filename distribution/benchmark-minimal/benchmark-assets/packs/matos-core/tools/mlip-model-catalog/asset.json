{
  "schemaVersion": 1,
  "id": "mlip-model-catalog",
  "type": "tool",
  "name": "MLIP Model Catalog",
  "version": "1.0.1",
  "description": "List locally mounted machine-learning interatomic-potential model assets and runtime package availability.",
  "entry": "./tool.py",
  "tags": [
    "materials",
    "mlip",
    "models",
    "catalog",
    "preflight"
  ],
  "permissions": {
    "shell": "disabled",
    "network": "disabled",
    "workspace": "read-only",
    "secrets": []
  },
  "metadata": {
    "kind": "external-tool",
    "sourceFormat": "cmatos-native-tool",
    "binding": "mcp__matos_asset__mlip_model_catalog",
    "promptPath": "prompt.md",
    "inputSchemaPath": "input.schema.json",
    "isReadOnly": true,
    "isDestructive": false,
    "family": "mlip",
    "executor": {
      "type": "matos-python",
      "runtime": "python3",
      "entry": "./tool.py",
      "timeoutMs": 20000,
      "mcpName": "mlip_model_catalog"
    },
    "marketplace": {
      "visibility": "public",
      "category": "tool"
    }
  }
}
