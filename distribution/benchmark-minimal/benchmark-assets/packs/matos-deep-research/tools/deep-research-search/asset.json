{
  "schemaVersion": 1,
  "id": "deep-research-search",
  "type": "tool",
  "name": "Deep Research Scholarly Search",
  "version": "0.1.0",
  "description": "Provider-agnostic scholarly literature search (OpenAlex) for the deep-research agent. Works on any model provider, unlike the Anthropic-only WebSearch tool.",
  "entry": "./tool.py",
  "tags": [
    "research",
    "deep-research",
    "search",
    "literature",
    "evidence"
  ],
  "permissions": {
    "shell": "disabled",
    "network": "enabled",
    "workspace": "read-only",
    "secrets": []
  },
  "metadata": {
    "kind": "external-tool",
    "sourceFormat": "cmatos-native-tool",
    "binding": "mcp__matos_asset__deep_research_search",
    "promptPath": "prompt.md",
    "inputSchemaPath": "input.schema.json",
    "isReadOnly": true,
    "isDestructive": false,
    "family": "deep-research",
    "executor": {
      "type": "matos-python",
      "runtime": "python3",
      "entry": "./tool.py",
      "timeoutMs": 30000,
      "mcpName": "deep_research_search"
    },
    "marketplace": {
      "visibility": "public",
      "category": "tool"
    }
  }
}
